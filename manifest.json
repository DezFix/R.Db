{
  "manifest_version": 3,
  "name": "R.Db — homelab desk for the new tab",
  "short_name": "R.Db",
  "version": "2.4.1",
  "description": "A minimal homelab-style dashboard in your new tab: bookmark groups with auto icons and titles, widgets, search. No servers, no Docker.",
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "R.Db",
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "background": {
    "service_worker": "bg.js",
    "scripts": [
      "core.js",
      "bg.js"
    ]
  },
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus",
    "alarms",
    "declarativeNetRequestWithHostAccess"
  ],
  "optional_permissions": [
    "bookmarks",
    "topSites",
    "notifications"
  ],
  "host_permissions": [
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*",
    "https://open.er-api.com/*",
    "https://api.coingecko.com/*",
    "https://api.microlink.io/*",
    "https://api.github.com/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "rdb-newtab@example.com",
      "strict_min_version": "121.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "optional_host_permissions": [
    "*://*/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}
